# --- Servidor ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# --- Base de datos (SQLite local via libsql) ---
DATABASE_URL=file:./data/bot.db

# --- WAHA ---
# URL donde corre tu contenedor de WAHA (puerto 3000 por defecto).
WAHA_BASE_URL=http://localhost:3000
# API key que configuraste en WAHA (env var WAHA_API_KEY del lado de WAHA — si no la
# fijás vos, WAHA genera una nueva al azar en cada arranque del contenedor y la
# imprime en sus logs: docker logs waha).
WAHA_API_KEY=changeme
# Clave HMAC para verificar que los webhooks vienen de WAHA (WHATSAPP_HOOK_HMAC_KEY del lado de WAHA).
# Opcional en desarrollo, pero se recomienda configurarla siempre.
WAHA_HMAC_KEY=
# Si es true, el bot no envía mensajes reales a WAHA: solo loguea qué hubiera enviado.
# Útil para probar todo el flujo sin tener WAHA corriendo ni un número conectado.
WAHA_DRY_RUN=true

# --- Comportamiento del bot ---
# Delay aleatorio (ms) antes de responder, para simular tiempo de escritura humano.
RESPONSE_DELAY_MIN_MS=1000
RESPONSE_DELAY_MAX_MS=3000

# --- Dashboard (Fase 3) ---
# Usuario y contraseña de HTTP Basic Auth para ver /dashboard en el navegador.
# DASHBOARD_PASSWORD es opcional a propósito: si la dejás vacía, la ruta /dashboard
# directamente no se monta (nunca se sirve un dashboard sin proteger).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

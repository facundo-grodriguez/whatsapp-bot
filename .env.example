# --- Servidor ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# --- Base de datos (SQLite local via libsql) ---
DATABASE_URL=file:./data/bot.db

# --- Meta WhatsApp Cloud API ---
# Versión de la Graph API (ver "Changelog" del App Dashboard antes de subirla).
META_GRAPH_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com
# App Dashboard > WhatsApp > API Setup > "Phone number ID" (NO es el número de
# teléfono en sí, es un id interno de Meta).
META_PHONE_NUMBER_ID=changeme
# App Dashboard > WhatsApp > API Setup > "Temporary access token" (dura ~24hs;
# para producción hace falta un token permanente de System User, ver README).
META_ACCESS_TOKEN=changeme
# App Dashboard > App Settings > Basic > "App secret". Verifica la firma
# X-Hub-Signature-256 de cada webhook. Opcional en desarrollo, OBLIGATORIA en
# producción (el server no arranca sin ella con NODE_ENV=production).
META_APP_SECRET=
# Elegilo vos (cualquier string) y cargá el mismo valor en App Dashboard >
# WhatsApp > Configuration > Webhook > "Verify token". Mismo criterio que
# META_APP_SECRET: opcional en desarrollo, obligatorio en producción.
META_VERIFY_TOKEN=
# Si es true, el bot no envía mensajes reales a Meta: solo loguea qué hubiera
# enviado. Útil para probar todo el flujo sin credenciales reales.
META_DRY_RUN=true

# --- Comportamiento del bot ---
# Delay aleatorio (ms) antes de responder. La API oficial no tiene riesgo de
# ban por comportamiento, así que el default es 0 (responder al instante).
# Subilo solo si preferís que se sienta menos robótico.
RESPONSE_DELAY_MIN_MS=0
RESPONSE_DELAY_MAX_MS=0
# Cuántas conversaciones DISTINTAS se procesan en paralelo ante un pico de tráfico.
# Dentro de una misma conversación siempre se procesa un mensaje a la vez, en orden,
# sea cual sea este valor (ver "Cola de procesamiento" en README.md).
QUEUE_CONCURRENCY=10

# --- Dashboard (Fase 3) ---
# Usuario y contraseña de HTTP Basic Auth para ver /dashboard en el navegador.
# DASHBOARD_PASSWORD es opcional a propósito: si la dejás vacía, la ruta /dashboard
# directamente no se monta (nunca se sirve un dashboard sin proteger).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# --- IA (Fase 4) ---
# Apagado (false) por defecto a propósito: es la única pieza del sistema con costo
# por request. Si es true, se usa OpenAI como fallback SOLO para preguntas que el
# motor de reglas no matcheó por keywords (ver src/engine/hybridEngine.ts) — nunca
# reemplaza a las reglas ni inventa datos del negocio fuera de las FAQs configuradas.
AI_FALLBACK_ENABLED=false
# Requerida si AI_FALLBACK_ENABLED=true (si no, el servidor no arranca).
OPENAI_API_KEY=
# Modelo económico por defecto, apto para respuestas cortas de primer contacto.
# Ajustar según el catálogo vigente de OpenAI y el presupuesto disponible.
OPENAI_MODEL=gpt-4o-mini
